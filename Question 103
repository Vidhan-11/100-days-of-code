#include<stdio.h>
int main(){
    unsigned int n;
    printf("Enter the number of elements you want to input : \n");
    scanf("%d",&n);
    int numbers[n];
    for(int i = 0;i < n;i++){
        printf("Number %d : ",i + 1);
        scanf("%d",&numbers[i]);
    }
    //Aim is to find the pivot of the array..
    int sum = 0,finder = 0,pivot;
    for(int i = 0;i < n;i++){
        sum += numbers[i];
    }
    for(int i = n - 1;i > 0;i--){
        finder += numbers[i];
        sum -= numbers[i];
        if(finder == sum ){
            printf("Pivot of the array is at index %d", i);
            return 0;
        }
    }
    printf("There is no pivot for this array.");
    return 0;
}
