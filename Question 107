#include<stdio.h>
int main(){
    int n;
    printf("Input size of array\n");
    scanf("%d",&n);
    printf("Input array\n");
    int arr[n],flag = 0;
    for(int i = 0;i<n;i++){
        printf("Number %d",i+1);
        scanf("%d",&arr[i]);
    }
    for(int i = 0;i<n;i++){
        for(int j = i;j >= 0;j--){
            if(arr[j] > arr[i]){
                printf("%d,",arr[j]);
                flag++;
                continue;
            }
        }
        if(flag == 0){
            printf("%d,",-1);
        }
    }
    return 0;
}
