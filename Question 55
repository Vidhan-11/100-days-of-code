#include<stdio.h>
int main(){
   int n,count =0;
   printf("Number : \n");
   scanf("%d",&n);
   printf("Prime number upto n are: \n");
   for(int i = 1;j < n;j++){
      for(int j =1;j< i;j++){
        if( i % j == 0){
            count ++;
        }
        if(count > 1){
            printf("%d",i);
        }
        printf("\n");
      }
      count = 0;
   }
    return 0;
}
