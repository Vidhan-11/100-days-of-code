#include<stdio.h>
#include<string.h>
int main(){
    char name[30];
    printf("Input Name :\n");
    fgets(name,30,stdin);
    for(int i = 0;i < strlen(name);i++){
        if(i == 0){
            printf("%c.",name[0]);
        }else if(name[i] == ' '){
            printf("%c.",name[i+1]);
        }
    }
    return 0;
}
