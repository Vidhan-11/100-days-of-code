#include<stdio.h>
void replace(char* a,char* b);
int main(){
    char string[] ="Vidhan Rawat ";
    for(int i = 0;i < sizeof(string)/2;i ++){
        replace(&string[i],&string[sizeof(string) - i]);
    }
    printf("%s",string);
    return 0;
}
void replace(char* a, char* b){
    char c = *a;
    *a = *b;
    *b = c;
}
