#include<stdio.h>
int main(){
int n,k;
printf("Enter the size of array : ");
scanf("%d",&n);
printf("Enter size of subarray : ");
scanf("%d",&k);
int arr[n];
printf("Enter array\n");
for(int i = 0;i < n;i++){
printf("Number %d : ",i+1);
scanf("%d",&arr[i]);
}
int curr_sum = 0,max_sum = 0;
for(int i = 0;i<n;i++){
curr_sum += arr[i];
if(curr_sum > max_sum){
max_sum = curr_sum;
}
if(curr_sum <0){
curr_sum = 0;
}
}
printf("Highest sum : %d",max_sum);
return 0;
}
