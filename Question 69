#include<stdio.h>
int main(){
    int arr[8]= {5,3,2,5,9,6,1};
    for(int i = 0;i< sizeof(arr);i++){
        for(int j = 0;j <sizeof(arr);j++){
            if(arr[j+1] > arr[j]){
                arr[j] = arr[j]^arr[j+1];
                arr[j+1] = arr[j]^arr[j+1];
                arr[j] = arr[j]^arr[j+1];
            }
        }
    }
    for(int i = 1 ;i < sizeof(arr);i++){
        if(arr[sizeof - i -1] != arr[sizeof -i]){
            printf("Second highest highest number is : %d",arr[sizeof - -i-1]);
        }
    }
    return 0;
}
