#include<stdio.h>
int main(){
   int size;
   printf("Input array size : \n");
   scanf("%d",&size);
    int num[size] , n ;
    for(int i = 0; i<size;i++){
        printf("Input number :%d \n", i+ 1);
        scanf("%d",&num[i]);
    }
    int first = 0,last = size -1,high = -1,low = -1,same = 1;
    
    while(first <= last){
        int mid = first + (last - first)/2 ;
        if(num[mid] == n){
            if(same == 1){
                low = mid;
                high = mid;
                same --;
            }
            else if(same = 0){
            if(mid > high ){
                high = mid;
            }else if(mid < low){
                low = mid;
            }
        }
        }
        else if(num[mid] < n){
            first = mid;
        }else{
            last = mid;
        }
    }
    if(high != -1){
    printf("First index of occurance is %d\nLast occurance of this element is %d\n",low , high);
    }else{
        printf("Index not found :%d,%d",low,high);
    }
    return 0;
}
