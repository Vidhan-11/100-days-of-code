#include<stdio.h>
int main(){
    int arr[10],target,i,count = 0,last = 0;
    printf("Input a sorted array:\n");
    for( i = 0;i<10;i++){
        printf("Input number %d\n",i+1);
        scanf("%d",&arr[i]);
        if(arr[i] == 101){
            break;
        }
    }
    printf("Enter the number you want to find in this array\n");
    scanf("%d",&target);
    for(int j = 0;j <= i;j++){
        if(arr[j] == target){
            count++;
            if(count == 1){
            printf("first occurance at %d\n",j);
            last = j;
        }
    }
    }
    if(count > 0){
        printf("Last occurance at %d",last);
    }else{
        printf("\n%d,%d",-1,-1);
    }
    return 0;
}
