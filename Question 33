#include<stdio.h>
#include<math.h>
int main(){
	int number,copy,i=10,num =1,armstrong;
	copy = number;
	while(number>0){
		if(number%i == 0){
			break;
		}
		num++;
		i*=10;
	}
	i = 10;
	while(number>0){
		armstrong += pow((number/i),num);
		i*=10;
	}
	if(armstrong == copy){
		printf("The number is an armstrong number\n");
	}else{
		printf("It is not an armstrong number.");
	}
	return 0;
}
