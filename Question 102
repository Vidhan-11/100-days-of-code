#include<stdio.h>
int main(){
    unsigned int n;
    float x ;
    printf("Enter the size of array: ");
    scanf("%d",&n);
    float arr[n],diff = 0;
    printf("Input a sorted array\n");
    for(int i = 0; i < n;i++){
        printf("Input number %d\n",i+1);
        scanf("%d",&arr[i]);
    }
    
    printf("Input a number you want to find the ceil of : \n");
    scanf("%f",&x);
    if(arr[0] > x){
        printf("\nCeil of this number in this array is %d",x);
        return 0;
    }
    int first = 0,last = n - 1;
    float ceil = -1;
    
    while( first <= last){
        int mid = (last+first)/2;
        if(arr[mid] ==  x){
            ceil = arr[mid];
            break;
        }else if(arr[mid] > x){
            ceil = arr[mid];
            last = mid -1;
        }else{
            first = mid + 1;
        }
    }
    printf("Ceil of this number in this array is : %.1f",ceil);
    return 0;
}
