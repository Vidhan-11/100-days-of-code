#include<stdio.h>
typedef struct{
    char name[20];
    int age;
    float average;
}student;
int main(){
    student s[3] = {
, {"Mukesh",17,89.4}
,{"Rohan",20,90.1}
,{"Sager",18,86.01}
}
    int j = 0,highest = s[0].average;
    for(int i = 0;i<3;i++){
        if(s[i].average >= highest){
            highest = s[i].average;
            j = i;
        }
    }
    printf("\nStudent with the highest marks->\nName : %s\nAge : %d\nMarks : %.2f",s[j].name,s[j].age,s[j].average);
    return 0;
}
