#include<stdio.h>
int main(){
    int n;
    printf("Input size of array");
    scanf("%d",&n);
    int arr[n],checker,flag = 0;
    printf("Input sorted array\n");
    for(int i = 0;i<n;i++){
        printf("Number %d",i+1);
        scanf("%d",&arr[i]);
    }
    checker = arr[0];
    for(int i = 0;i<n;i++){
        for(int j = 0;j<n;j++){
            if(arr[j] > checker){
                printf("%d,",arr[i]);
                checker = arr[j];
                i = j + 1;
                flag++;
            }
        }
        if(flag == 0){
            printf("%d,",-1);
        }
        flag = 0;
    }
    return 0;
}
