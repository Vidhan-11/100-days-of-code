#include<stdio.h>
int main(){
   int matrix[2][2] ,sum[];
   for(int i = 0; i < 2;i++){
    for(int j = 0;j < 2;j++){
        printf("Input number %d,%d",i + 1,j + 1);
        scanf("%d",matrix[i][j]);
    }
   }
   for(int i = 0; i < 2;i++){
    for(int j = 0;j < 2;j++){
        sum[i] += matrix[i][j];
    }
   }
   printf("]");
   for(int i = 0; i < 2;i ++){
    printf("%d,",sum[i]);
   }
   printf("]");
    return 0;
}
