#include<stdio.h>
//The file to be opened contains all numbers seprated by spaces..
int main(){
    FILE* file;
    file = fopen("numbers.txt","r");
    if(file == NULL){
        printf("Error in opening file");
    }
    int num , sum = 0;
    while(fscanf(file,"%d",&num) == 1){
        sum += num;
    }
    printf("Sum of numbers : %d",sum);
    fclose(file);
    return 0;
}
