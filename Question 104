#include<stdio.h>
int equality(int n,int m);
int main(){
    int n,x,first = 1,last = n;
    printf("Input Number :\n");
    scanf("%d",&n);
    while(first <= last){
        int mid = (first + last)/2;
        if(equality(mid,n) == 1){
            printf("pivit for the given number from 1 is : %d",mid);
            return 0;
        }else if(equality(mid,n) == -1){
            first = mid;
        }else if(equality(mid,n) == 0){
            last = mid;
        }
    }
    printf("There is no pivot upto the input value form 1");
    return 0;
}
int equality(int n,int m){
    int f_half,s_half;
    f_half = n*(n+1)/2;
    s_half = (m - n + 1) * ( 2*n + n - 1) / 2;
    if (f_half == s_half){
        return 1;
    }else if(f_half < s_half ){
       return -1;
    }else{
        return 0;
    }
}
