#include<stdio.h>
int main(){
   int matrix[2][2] ,sum = 0;
   for(int i = 0; i < 2;i++){
    for(int j = 0;j < 2;j++){
        printf("Input number %d,%d",i + 1,j + 1);
        scanf("%d");
    }
   }
   for(int i = 0; i < 2;i++){
    for(int j = 0;j < 2;j++){
        sum += matrix[i][j];
    }
   }
   printf("Sum of all number in this matrix is : %d", sum);

    return 0;
}
