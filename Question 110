#include<stdio.h>
int main(){
int n;
printf("Input size of array:\n");
scanf("%d",&n);
int arr[n],k;
printf("Input array\n");
for(int i = 0;i<n;i++){
printf("Number %d: ",i+1);
scanf("%d",&arr[i]);
}
printf("Input size of subarray:");
scanf("%d",&k);
for(int i = 0;i<n;i++){
int num = arr[i],count = 1;
if(count <=k ){
if(arr[i]>num){
num = arr[i];
}
count ++;
}
if(count > k){
printf("%d\t",num);
count = 1;
}
}
return 0;
}
