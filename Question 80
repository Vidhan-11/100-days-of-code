#include<stdio.h>

int main(){
    int matrix_1[3][3],matrix_2[3][3],product[3][3];
    for(int i = 0;i <3;i++){
        for(int j = 0;j <3;j++){
            for(int k = 0;k<3;k++){
                product[i][j] += matrix_1[i][k]*matrix_2[k][j];
            }
        }
    }
    for(int i = 0;i < 3;i++){
        for(int j = 0;j<3;j++){
        printf("%d\t",product[i][j]);
    }
printf("\n");
}
    return 0;
}
