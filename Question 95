#include<stdio.h>
#include<string.h>
//string should not be rotates around the last element.
int main(){
    char string_1[],string_2[];
    int st_idx = 0;
    for(int i = 0;i < strlen(string_2);i++){
        if(string_1[0] == string_2[i] && string_1[1] == string_2[i+1]){
            st_idx = i;
            break;
        }
    }
    for(int i = st_idx;i < strlen(string_1);i++){
        if(string_1[i-st_idx] != string_2[i]){
            printf("Second string is not rotation of the first/\n");
            return 0;
        }
    }
    for(int i = 0;i < st_idx;i++){
        if(string_1[i + st_idx] != string_2[i]){
            printf("Second string is not rotation of the first.\n");
            return 0;
        }
    }
    printf("Second string is the rotation of the first around the %dth element",st_idx);
    return 0;
}
