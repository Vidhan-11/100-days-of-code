#include<stdio.h>
//Majority element finding algorithm.
int main(){
    int n,frequency = 0,maj_ele;
    printf("Input the size of array :\n");
    scanf("%d",&n);
    int numbers[n];
    printf("Input elements of array.\n");
    for(int i = 0;i< n;i++){
        printf(" Number %d : ",i + 1);
        scanf("%d",&numbers[i]);
    }
    maj_ele = numbers[0];
    for(int i = 1;i < n;i++){
        if(frequency == 0){
            maj_ele = numbers[i];
        }
        if(maj_ele == numbers[i]){
            frequency ++;
            
        }else{
            frequency --;
        }
        
    }
    printf("The majority element of this array is %d\n",maj_ele);
    return 0;
}
