#include<stdio.h>
typedef struct{
    char name[20];
    int age,roll_num;
    float marks;
}student;
int main(){
    student s[5];
    s[0] = {"Rohan",18,54,87.5};
    s[1] = {"Vikas",19,43,92.4};
    s[2] = {"Ritvik",19,23,80.2};
    s[3] = {"Mohit",20,89,76,8};
    s[4] = {"Harish",21,65,90.3};
    for(int i = 0; i < 5;i++){
        printf("\nStudent %d ->\nName : %s\nAge : %d\nRoll number : %d\nMarks : %.2f\n",i+1,s[i].name,s[i].age,s[i].roll_num,s[i].marks);
    }
    printf("\nThis was data of students which was previously known.");
    return 0;
}
