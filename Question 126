#include<stdio.h>
#include<string.h>
int main(){
    char filename[20],c;
    printf("Enter a filename to open\n");
    fgets(filename,20,stdin);
    filename[strcspn(filename,"\n")] = '\0';
    FILE* file;
    file = fopen(filename,"r");
    if(file == NULL){
        printf("Error in opening file");
        return 1;
    }else{
    while(fread(&c,1,1,filename) == 1){
        printf("%c",c);
    }
}
    fclose(filename);
    return 0;
}
