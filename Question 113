#include<stdio.h>
int main(){
int n,k,count = 0;
printf("Enter size of array : ");
scanf("%d",&n);
int arr[n];
for(int i = 0;i<n;i++){
printf("Number %d : ",i+1);
scanf("%d",arr[i]);
}
printf("Enter the K for Kth smallest value : ");
scanf("%d",k);
for(int i = 0;i < n;i++){
for(int j= i;j > 0;j--){
if(arr[j] < arr[j-1]){
int temp = arr[j];
arr[j] = arr[j-1];
arr[j-1] = temp;
}
}
}
for(int i = n; i >= 0;i--){
if(arr[i] != arr[i-1]){
count++;
}
if(count == k){
printf("%d",arr[i]);
break;
}
}
return 0;
}
