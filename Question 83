#include<stdio.h>
int value(char n);
int main(){
    char name[] = "Vidhan";
    int vowels = 0,consonents =0;
    for(int i = 0;!( name[i] = '\0');i++){
        if(65< value(name[i]) && value(name[i])< 69){
            vowels ++;
        }else{
            consonents++;
        }
    }   
    printf("Total number of vowels in array is %d\n",vowels);
    printf("Total number of consonents in array is %d",consonents);


    return 0;
}
int value(char n){
    return n;
}
