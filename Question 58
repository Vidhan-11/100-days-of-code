#include<stdio.h>
int main(){
   int max,min,n[8] = {3,5,6,2,1,5,9,8};
    max = n[0];
    min = n[0];
    for(int i = 0;i <8;i++){
        if(max < n[i]){
            max = n[i];
        }
        if(min > n[i]){
            min = n[i];
        }
    }
    printf("Max : %d\nMin : %d",max,min);
    return 0;
}
